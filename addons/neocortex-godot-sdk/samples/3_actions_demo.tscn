bbcode_enabled = true
text = "[b]This scene demonstrates single and stacked actions with Neocortex.[/b]

[b][color=#F59E0B]01[/color][/b] Cora has two actions in this scene, Dance and Jump.
[b][color=#F59E0B]02[/color][/b] Tell Cora to [b]dance[/b] (speak, or type) and watch the action play her animation.
[b][color=#F59E0B]03[/color][/b] Then tell her to [b]jump[/b] and then [b]dance[/b], and watch stacked actions run in order."
fit_content = true
scroll_active = false

