mouse_filter = 2
bbcode_enabled = true
text = "[b]Neocortex's group chat, where characters or the player can join or leave at any time.[/b]

[b][color=#F59E0B]01[/color][/b] Set up the characters on the NeocortexSmartAgent nodes.
[b][color=#F59E0B]02[/color][/b] Use the toggles at the top of the screen to make characters join or leave.
[b][color=#F59E0B]03[/color][/b] In this demo, joining or leaving starts the next conversation round.
[b][color=#F59E0B]04[/color][/b] Speak to the group to start another round. Group chat needs a Pro or Team key."
fit_content = true
scroll_active = false

